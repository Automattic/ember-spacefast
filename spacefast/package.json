{
  "name": "ember-spacefast",
  "private": true,
  "type": "module",
  "dependencies": {
    "@37signals/lexxy": "0.9.24",
    "@rails/activestorage": "8.1.401",
    "@spacefast/zero": "0.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.9.0",
    "preact": "10.29.8",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.27.7",
    "spacefast": "0.8.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "npm run build && sf dev --state-backend sqlite",
    "typecheck:server": "npm run source:prepare && tsc --noEmit --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --allowJs server/index.ts",
    "build:check": "npm run build && sf dev --dry-run --json",
    "build:styles": "npm run source:prepare && node scripts/build-styles.mjs",
    "build:client": "npm run source:prepare && node scripts/build-client.mjs",
    "build": "npm run source:prepare && node scripts/build-styles.mjs && node scripts/build-client.mjs && node scripts/package-static.mjs",
    "source:prepare": "node scripts/ember-source.mjs prepare",
    "source:check": "node scripts/ember-source.mjs check",
    "source:capture": "node scripts/ember-source.mjs capture",
    "source:pin": "node scripts/ember-source.mjs pin",
    "test": "npm run source:prepare && node --test tests/*.test.mjs",
    "package:serving": "npm run build --silent >&2 && node scripts/package-serving.mjs"
  },
  "overrides": {
    "@spacefast/zero": {
      "zod": "4.6.7"
    }
  }
}
