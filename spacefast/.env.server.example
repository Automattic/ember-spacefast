# Pin first setup to the owner's native Spacefast account principal.
# Use account: followed by the exact Spacefast account ID.
# EMBER_ADMIN_PRINCIPAL=account:YOUR_SPACEFAST_ACCOUNT_ID

# Use a verified native sign-in email when EMBER_ADMIN_PRINCIPAL is unset.
EMBER_ADMIN_EMAIL=

# Optional verified-email signup. Comma-separated exact domains, for example example.test,team.example.test.
EMBER_SIGNUP_EMAIL_DOMAINS=

# Enable native email invitations only after setting a verified sender and actual public origin.
EMBER_EMAIL_FROM=
EMBER_PUBLIC_URL=

# Optional actual acquired-logo social image path after it exists.
EMBER_SOCIAL_IMAGE=

# Optional public Spacefast Git path (team-slug/space-slug) to show a Remix link on About.
EMBER_REMIX_REPOSITORY=

# Optional outgoing webhook replies. Set a high-entropy server-only value of at least 32 characters.
# Also set EMBER_PUBLIC_URL to the HTTPS origin that accepts bot reply callbacks.
EMBER_BOT_SIGNING_KEY=

# Optional server-only bearer for manual recovery runs. Scheduled runs use Spacefast's cron header.
EMBER_BOT_CRON_TOKEN=

# Optional browser push. Use a server-only base64url P-256 private scalar and a real mailto: contact or HTTPS contact page.
EMBER_PUSH_PRIVATE_KEY=
EMBER_PUSH_CONTACT=

# Optional server-only bearer for manual push recovery runs.
EMBER_PUSH_CRON_TOKEN=

# Optional Ember AI. Use server variables from the same OpenAI project.
EMBER_OPENAI_API_KEY=
EMBER_OPENAI_MODEL=
EMBER_OPENAI_WEBHOOK_SECRET=

# Optional server-only bearer for manual assistant recovery.
EMBER_ASSISTANT_CRON_TOKEN=
